{
  "expo": {
    "name": "QOT",
    "slug": "qot-mobile",
    "owner": "nsacent",
    "scheme": "qot",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon-qot.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ug.qot.mobile",
      "buildNumber": "12",
      "associatedDomains": [
        "applinks:qot.ug"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow QOT to take photos for your ads and profile.",
        "NSLocationWhenInUseUsageDescription": "Allow QOT to use your location to show nearby ads and choose your ad area.",
        "NSPhotoLibraryAddUsageDescription": "Allow QOT to save images you choose to download.",
        "NSPhotoLibraryUsageDescription": "Allow QOT to choose photos for your ads and profile."
      }
    },
    "android": {
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-qot.png",
        "backgroundColor": "#FFF7F2"
      },
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "ug.qot.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qot.ug",
              "pathPrefix": "/ads"
            },
            {
              "scheme": "https",
              "host": "qot.ug",
              "pathPrefix": "/sellers"
            },
            {
              "scheme": "https",
              "host": "qot.ug",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#FFF7F2",
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFF7F2",
      "barStyle": "dark-content"
    },
    "extra": {
      "googleWebClientId": "469848009032-cp7lad868jnfbjcn4qjgifumnqvm99m7.apps.googleusercontent.com",
      "eas": {
        "projectId": "911e4830-a036-4af8-b5a5-26048327e0cc"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/images/qot-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7F2"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QOT to choose photos for your ads and profile.",
          "cameraPermission": "Allow QOT to take photos for your ads and profile.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow QOT to use your location to show ads near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F97316",
          "defaultChannel": "qot-updates"
        }
      ]
    ]
  }
}
