{
  "expo": {
    "name": "QOT",
    "slug": "qot-mobile",
    "owner": "nsacent",
    "scheme": [
      "qot",
      "fb2278313346334664"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-qot.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/assets/images/qot-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ug.qot.mobile",
      "associatedDomains": [
        "applinks:qot.ug"
      ]
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-qot.png",
        "backgroundColor": "#FFFDF9"
      },
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "ug.qot.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qot.ug",
              "pathPrefix": "/ads"
            },
            {
              "scheme": "https",
              "host": "qot.ug",
              "pathPrefix": "/sellers"
            },
            {
              "scheme": "https",
              "host": "qot.ug",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#FFFDF9",
      "barStyle": "dark-content"
    },
    "extra": {
      "facebookAppId": "2278313346334664",
      "googleWebClientId": "469848009032-cp7lad868jnfbjcn4qjgifumnqvm99m7.apps.googleusercontent.com",
      "eas": {
        "projectId": "911e4830-a036-4af8-b5a5-26048327e0cc"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/images/qot-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDF9"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QOT to choose photos for your ads and profile.",
          "cameraPermission": "Allow QOT to take photos for your ads and profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow QOT to use your location to show ads near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "defaultChannel": "qot-updates"
        }
      ]
    ]
  }
}
